    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this CV and grade the candidate:\n\n{{ $json.text }}\n\nEvaluate based on:\n1. Technical Skills (0-100): Depth and breadth of technical expertise, modern tech stack knowledge\n2. Experience (0-100): Years of relevant experience, progression, impact of previous roles\n3. Education (0-100): Academic credentials, certifications, continuous learning\n4. Cultural Fit (0-100): Evidence of teamwork, leadership, values alignment, adaptability\n5. Communication Quality (0-100): CV clarity, grammar, presentation, storytelling ability\n6. Career Progression (0-100): Growth trajectory, increasing responsibility, strategic moves\n\nCalculate an overall score (weighted average: Technical 30%, Experience 25%, Education 15%, Cultural Fit 15%, Communication 10%, Career Progression 5%).\n\nA candidate PASSES if overall score >= 70.\n\nProvide specific strengths, concerns, and a recommendation.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an expert technical recruiter with 15 years of experience evaluating data engineering candidates. You have a keen eye for identifying top talent and assessing both technical capabilities and soft skills. Be thorough, fair, and provide actionable insights."
        }
      },
